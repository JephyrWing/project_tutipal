# Spring은 .env를 자동으로 읽지 않는다. IDE 환경변수로 등록하거나 Compose를 사용한다.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://127.0.0.1:5432/tutipal_db
DB_USER=tutipal
DB_PW=CHANGE_ME_DATABASE_PASSWORD
FAST_API_BASE_URL=http://127.0.0.1:8000
AI_INTERNAL_KEY=CHANGE_ME_RANDOM_INTERNAL_KEY
AI_MAX_CONCURRENT=2
# 공개 환경에서 반드시 false. 단일 PC 개발 확인에만 true.
DEV_LOGIN=false
# 외부 HTTPS 앱의 WebSocket Origin은 명시적으로 추가한다. * 단독 사용 금지.
APP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
SESSION_COOKIE_SECURE=false
# 개발용 local 저장소는 Spring에만 마운트한다. 운영은 s3 사용.
MATERIAL_STORAGE=local
MATERIAL_LOCAL_PATH=./data/materials
AWS_REGION=ap-northeast-2
S3_BUCKET=
# AWS 값은 Spring 프로세스에만 주입. 역할/기본 자격 증명 체인 사용도 가능
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# 필요한 공급자의 ID와 비밀값을 쌍으로 설정한다. 비우면 해당 로그인은 비활성.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
