{
  "name": "tutipal-front",
  "productName": "TUTIPAL",
  "version": "0.0.1",
  "description": "TUTIPAL desktop widget scaffold",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/bridge.cjs && node --check electron/applogin.cjs && node --check electron/screen.cjs && node --check electron/share.cjs && node --check scripts/dev.mjs && node --check vite.config.js"
  },
  "dependencies": {
    "livekit-client": "2.24.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@stomp/stompjs": "7.5.0",
    "pretendard": "1.3.9",
    "react-router-dom": "7.18.5",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.17.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.tutipal.desktop",
    "productName": "TUTIPAL",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "protocols": [
      {
        "name": "TUTIPAL",
        "schemes": [
          "tutipal"
        ]
      }
    ]
  },
  "author": "TUTIPAL 팀",
  "tutipal": {
    "serverUrl": "http://127.0.0.1:8080"
  }
}
