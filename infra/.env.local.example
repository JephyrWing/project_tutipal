COMPOSE_PROJECT_NAME=tutipal-local
DB_NAME=tutipal_db
DB_USER=tutipal
DB_PW=CHANGE_ME_DATABASE_PASSWORD
# 로컬 전용. 공개 공유기의 포트포워딩 대상으로 사용하지 않는다.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
DB_PORT=5432
FASTAPI_PORT=8000
SESSION_COOKIE_SECURE=false
# 개인 PC에서 직접 로그인 검증할 때만 true. 기본 false.
DEV_LOGIN=false
APP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
# Spring과 FastAPI 사이 전용 인증키. 앱에는 전달하지 않는다.
AI_INTERNAL_KEY=CHANGE_ME_INTERNAL_AI_KEY
AI_MAX_CONCURRENT=2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET_AT_LEAST_32_CHARACTERS
# 단일 PC 확인용. 외부/LAN 사용 시 도달 가능한 호스트 IP를 지정한다.
LIVEKIT_NODE_IP=127.0.0.1
# auto: 설치된 Ollama 모델 우선, 없거나 접속 불가하면 OpenAI 사용. ollama/openai 고정도 가능.
MODEL_PROVIDER=auto
# 각 팀원이 자신의 Ollama 모델명으로 변경한다. 이 PC는 gemma4-ally:latest 사용.
MODEL_NAME=gemma4-ally:latest
MODEL_BASE_URL=http://host.docker.internal:11434
MODEL_API_KEY=
EMBEDDING_MODEL=bge-m3
# 로컬 모델이 없는 팀원은 OpenAI 키와 모델명을 설정한다. 키는 FastAPI에만 전달한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_COMPLETION_TOKENS=4096
# PT-86 RAG rerank (both off by default; turn on together after docs/PT-86_RAG_EVAL.md adoption)
TUTIPAL_RAG_RERANK_ENABLED=false
RERANK_ENABLED=false
RERANK_THREADS=2
RERANK_MAX_LENGTH=256
RERANK_QUEUE_TIMEOUT_MS=1000
TUTIPAL_RAG_RERANK_CANDIDATES=10
# PT-90 focus model (LightGBM .txt + sidecar .json, mounted separately). Empty = off (state shows "unknown")
FOCUS_MODEL_PATH=
FOCUS_MODEL_SHA256=
# char800-v1 | section-v1 (changing it needs docs/RAG_REINDEX.md)
TUTIPAL_MATERIALS_CHUNKER=char800-v1
# DB vector(1024)와 일치해야 한다. 다른 차원은 DB 마이그레이션이 필요하다.
EMBEDDING_DIMENSIONS=1024
AWS_REGION=ap-northeast-2
S3_BUCKET=
# 개발용 자료 원본은 Spring 전용 볼륨에 보존. 운영은 s3를 사용한다.
MATERIAL_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
