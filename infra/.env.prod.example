COMPOSE_PROJECT_NAME=tutipal
# 이미지 레지스트리(소문자 GitHub 소유자)와 배포할 커밋 SHA. CD는 둘 다 환경변수로 덮어쓴다.
IMAGE_REGISTRY=ghcr.io/CHANGE_ME_LOWERCASE_GITHUB_OWNER
IMAGE_TAG=CHANGE_ME_COMMIT_SHA
DB_NAME=tutipal_db
DB_USER=tutipal
DB_PW=CHANGE_ME_STRONG_DATABASE_PASSWORD
BACKEND_PORT=8080
SESSION_COOKIE_SECURE=true
APP_ALLOWED_ORIGINS=https://CHANGE_ME_SPRING_DOMAIN
# PT-110: AI node address. PC AI server through Cloudflare Tunnel 2: https://ai.<domain> (no trailing slash).
# Old layout (FastAPI on this EC2): http://fastapi:8000 and start with --profile ec2-ai (deploy.sh: ENABLE_EC2_AI=true).
FAST_API_BASE_URL=https://CHANGE_ME_AI_DOMAIN
# Same value on both servers: here and AI_INTERNAL_KEY in the PC infra/.env.ai-node.
AI_INTERNAL_KEY=CHANGE_ME_INTERNAL_AI_KEY
# PT-110 Cloudflare Access service token (Zero Trust > Access > Service Auth) allowed by the ai.<domain> application.
# Spring sends them as CF-Access-Client-Id / CF-Access-Client-Secret. Set both or leave both empty (same-host FastAPI).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# PT-110 whole-request limits of the short AI calls through the tunnel. Defaults are the measured values (2s);
# raise only after the docs/DEPLOYMENT.md 7.6 measurement shows it is needed.
TUTIPAL_RAG_RERANK_TIMEOUT=2s
APP_FOCUS_PREDICT_TIMEOUT=2s
AI_MAX_CONCURRENT=2
# PT-85 학생/개인 학습 Agent. 기본 false(기존 /v1/chat 경로). FastAPI /v1/agent/chat 배포 확인 후 true로 켠다
AI_AGENT_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET_AT_LEAST_32_CHARACTERS
# 외부 클라이언트가 직접 도달하는 미디어 IP. Cloudflare 프록시 IP가 아니다.
LIVEKIT_NODE_IP=CHANGE_ME_REACHABLE_MEDIA_IP
# MODEL_* / OPENAI_* / RERANK_* / FOCUS_* below are read only by the same-host FastAPI (--profile ec2-ai).
# With the PC AI node they are set in the PC infra/.env.ai-node instead. TUTIPAL_* lines stay Spring settings.
MODEL_PROVIDER=auto
MODEL_NAME=gemma4-ally:latest
MODEL_BASE_URL=http://host.docker.internal:11434
MODEL_API_KEY=
EMBEDDING_MODEL=bge-m3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_COMPLETION_TOKENS=4096
# PT-86 RAG rerank (both off by default; turn on together after docs/PT-86_RAG_EVAL.md adoption)
TUTIPAL_RAG_RERANK_ENABLED=false
RERANK_ENABLED=false
RERANK_THREADS=2
RERANK_MAX_LENGTH=256
RERANK_QUEUE_TIMEOUT_MS=1000
TUTIPAL_RAG_RERANK_CANDIDATES=10
# PT-90 focus model (LightGBM .txt + sidecar .json, mounted separately). Empty = off (state shows "unknown")
FOCUS_MODEL_PATH=
FOCUS_MODEL_SHA256=
# char800-v1 | section-v1 (changing it needs docs/RAG_REINDEX.md)
TUTIPAL_MATERIALS_CHUNKER=char800-v1
EMBEDDING_DIMENSIONS=1024
# 운영 자료 원본은 S3. 비우면 AWS_REGION은 compose 기본값 ap-northeast-2를 쓴다.
# EC2 IAM 역할을 연결하면 액세스 키 두 줄은 비워 둔다(AWS SDK 기본 자격 증명 체인).
AWS_REGION=
S3_BUCKET=
MATERIAL_STORAGE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cloudflare에서 Spring만 향하는 Tunnel의 토큰을 설정한다.
CLOUDFLARE_TUNNEL_TOKEN=
# 실제 운영에서는 검증한 태그/다이제스트로 고정. cloudflare profile에서만 사용.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
