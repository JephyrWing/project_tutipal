# PT-110 AI node (team PC). Copy to infra/.env.ai-node and fill in on that PC only. Names and descriptions only:
# never commit real values. Guide: docs/DEPLOYMENT.md 7.
#
# Same value as AI_INTERNAL_KEY in the EC2 infra/.env.prod. Spring sends it as X-Internal-Key; a mismatch is 401
# and the app shows "AI 조교에 연결할 수 없어요".
AI_INTERNAL_KEY=CHANGE_ME_SAME_AS_EC2_AI_INTERNAL_KEY
# Token of the AI-only Cloudflare Tunnel (Tunnel 2, public hostname ai.<domain> -> http://fastapi:8000).
# Not the EC2 Spring tunnel token.
CLOUDFLARE_AI_TUNNEL_TOKEN=
# Pin a checked tag/digest in real use (docs/DEPLOYMENT.md 6). latest is a placeholder.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# Image name of the locally built FastAPI (built from tutipal_ai with --build).
AI_NODE_IMAGE=local/tutipal-fastapi:ai-node
# Loopback port on this PC for local checks (http://127.0.0.1:8000/health).
AI_NODE_PORT=8000
# ollama = only the GPU models on this PC. auto would fall back to OpenAI when OPENAI_API_KEY is set
# (external transfer and cost: AGENTS.md 7), so leave OPENAI_API_KEY empty unless the PM approved it.
MODEL_PROVIDER=ollama
MODEL_NAME=gemma3:4b
# Ollama installed on Windows, seen from the container
MODEL_BASE_URL=http://host.docker.internal:11434
MODEL_API_KEY=
EMBEDDING_MODEL=bge-m3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_COMPLETION_TOKENS=4096
# PT-86 rerank: WITH_RERANKER=true bakes the model into the image at build time; RERANK_ENABLED turns the path on.
# Turn on together with TUTIPAL_RAG_RERANK_ENABLED on EC2 (docs/PT-86_RAG_EVAL.md).
WITH_RERANKER=false
RERANK_ENABLED=false
RERANK_THREADS=2
RERANK_MAX_LENGTH=256
# keep below the EC2 TUTIPAL_RAG_RERANK_TIMEOUT
RERANK_QUEUE_TIMEOUT_MS=1000
# PT-90 focus model. FOCUS_MODEL_DIR is a folder on this PC mounted read-only at /models/focus
# (empty = infra/ai-node-models, git-ignored). FOCUS_MODEL_PATH is the path inside the container,
# e.g. /models/focus/<model>.txt with the sidecar .json next to it. Empty path = off (state shows "unknown").
FOCUS_MODEL_DIR=
FOCUS_MODEL_PATH=
FOCUS_MODEL_SHA256=
