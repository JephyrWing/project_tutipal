# Compose는 Spring과 Python에 필요한 변수만 각각 전달한다.
# Python 단독 실행 시 IDE/프로세스 환경변수로 등록한다. .env는 자동으로 읽지 않는다.
# 추론 API는 Spring과 동일한 임의 키가 필요하다. 실제 값을 저장소에 넣지 않는다.
AI_INTERNAL_KEY=CHANGE_ME_RANDOM_INTERNAL_KEY
# auto: 로컬 모델 우선, 미설치·접속 불가 시 아래 OpenAI 설정으로 전환.
# ollama: 로컬만 사용. openai: 외부 API만 사용. 모델 이름은 팀원 PC에 맞춰 변경한다.
MODEL_PROVIDER=auto
MODEL_NAME=gemma4-ally:latest
MODEL_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# 외부 전환에는 유효한 OpenAI API 키가 필요하며 요청 내용이 OpenAI로 전송되고 사용량이 청구될 수 있다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_COMPLETION_TOKENS=4096
# 이전 예약 변수. OpenAI 인증에는 위 OPENAI_API_KEY만 사용한다.
MODEL_API_KEY=
# 이전 PL 설정 이름도 지원: LLM_PROVIDER, OLLAMA_MODEL, OLLAMA_BASE_URL.
# 위 MODEL_* 값이 비어 있지 않으면 해당 별칭보다 우선한다.
# Windows venv에서 직접 실행한다면 MODEL_BASE_URL=http://127.0.0.1:11434 로 지정한다.
# DB_URL, AWS_*, S3_BUCKET, LIVEKIT_API_SECRET은 이 서버에 넣지 않는다.
